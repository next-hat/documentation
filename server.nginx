server {
  listen       80;
  listen  [::]:80;
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 8;
  gunzip on;
  gzip_types application/javascript application/json image/svg+xml text/css text/plain;
  gzip_disable "MSIE [1-6]\.";

  root /home/node/app;
  index index.html;
  error_page 404 /404.html;
  rewrite ^/(.+)/$ /$1 permanent;

  location / {
    try_files $uri $uri.html $uri/index.html =404;
    add_header Cache-Control "no-cache" always;
  }

  # Static exports do not preserve the feed route's response headers.
  location ~ ^/(fr/|ru/|ja/|zh-Hans/)?blog/feed\.json$ {
    types { application/feed+json json; }
    charset utf-8;
    charset_types application/feed+json;
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
  }

  # Next.js fingerprints these assets, so cached copies remain valid.
  location ^~ /_next/static/ {
    try_files $uri =404;
    access_log off;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
}
