{
  "name": "next-hat-documentation",
  "version": "0.18.3",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --filter @next-hat/documentation dev",
    "start": "pnpm dev",
    "build": "pnpm --filter @next-hat/documentation build",
    "preview": "pnpm --filter @next-hat/documentation preview",
    "typecheck": "pnpm --filter @next-hat/documentation typecheck",
    "check": "node --test --test-isolation=none apps/documentation/lib/openapi.test.mjs && node scripts/check-content.mjs"
  },
  "engines": { "node": ">=24" }
}
